# ===== DeepSeek（LLM，OpenAI 兼容接口） =====
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_ANALYSIS_TIMEOUT_MS=45000

# ===== Tavily 搜索 =====
TAVILY_API_KEY=replace-me

# ===== 本地 PostgreSQL（Docker Desktop + Drizzle ORM） =====
# 启动：./scripts/db-up.ps1，然后执行 corepack pnpm db:migrate
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stock_analysis

# ===== Cloudflare R2 对象存储 =====
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=stock-analysis
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# ===== 本地服务地址 =====
DATA_SERVICE_URL=http://127.0.0.1:8000

# ===== 单机定时任务（可选） =====
CLEANUP_CRON=0 3 * * *
REFRESH_CRON=30 3 * * *
FUND_REFRESH_CRON=45 3 * * *

# ===== 预警中心（可选） =====
# 预警扫描：交易日每 30 分钟一次；实际是否触发由交易时段判定决定
ALERT_CRON=*/30 9-15 * * 1-5
# 可配置预警任务的自选标的数量上限（股票 + 基金合计）
ALERT_MAX_TARGETS=3
# 默认收件邮箱（也可在预警中心面板里设置，保存在本地 .data/alert-settings.json）
ALERT_EMAIL_TO=replace-me@example.com

# ===== 预警邮件 SMTP（QQ 邮箱，可选；未配置时预警仅页面展示） =====
# 授权码获取：QQ 邮箱 → 设置 → 账号 → 开启 SMTP 服务 → 生成 16 位授权码（注意不是 QQ 登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=replace-with-your-qq@qq.com
SMTP_PASS=replace-with-qq-smtp-auth-code
SMTP_FROM=replace-with-your-qq@qq.com
# ===== AI 收盘日报（可选） =====
# 探测式触发：交易日 15:10 起每 10 分钟探测一次，数据就绪即生成，当天只生成一次
DAILY_STOCK_REPORT_CRON=*/10 15-16 * * 1-5
# 基金日报：交易日晚间每 20 分钟探测一次，当日净值公布即生成
DAILY_FUND_REPORT_CRON=*/20 20-23 * * 1-5
# 单篇日报的模型生成超时（毫秒）
DAILY_REPORT_TIMEOUT_MS=60000