{
  "name": "stock-analysis-web",
  "version": "0.1.0",
  "private": true,
  "description": "个股与基金盘面分析网站（Next.js + FastAPI 行情/基金数据侧车）",
  "scripts": {
    "scheduler:worker": "node scripts/scheduler-worker.mjs",
    "scheduler:once": "node scripts/scheduler-worker.mjs --once",
    "dev": "next dev",
    "dev:data": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-data.ps1",
    "dev:all": "concurrently -n web,data -c cyan,green \"pnpm dev\" \"pnpm dev:data\"",
    "start:win": "cmd /c start.bat",
    "start:linux": "bash ./start.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "data:cleanup": "node scripts/data-cleanup.mjs",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.1",
    "postgres": "^3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.24.0"
}
