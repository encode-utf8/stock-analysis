# 环境变量与密钥（API Key 等，绝不入库）
.env
.env.*
!.env.example
# 迁移导出配置（含明文密钥，勿入库；由 export-config.ps1 / export-config.sh 生成）
.env.export

# 本地配置与证书
config.local.*
secrets.*
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# 项目专属 conda 环境（如需本地安装）
.conda/

# Node.js
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.pnp
.pnp.*

# 测试覆盖率产物
coverage/

# Playwright 端到端产物（截图、trace 与报告）
test-results/
playwright-report/

# Next.js 与构建产物
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# 一键启动脚本日志
.logs/

# 本地持久化数据
.data/

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/
